{
  "name": "lunwen-reader",
  "description": "材料解读助手 — 分析论文、GitHub 项目与本地工作区",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ant-design/x-markdown": "^2.9.0",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
